{
  "name": "life",
  "private": true,
  "version": "0.1.0",
  "description": "LIFE — simulateur de vie par choix textuels, généré par IA",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run typecheck && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace server"
  },
  "engines": {
    "node": ">=20"
  }
}
